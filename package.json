{
  "name": "oneclickhistorycleaner",
  "version": "0.1.28",
  "type": "module",
  "description": "One Click History Cleaner with hot reload",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun --bun vite build",
    "build:firefox": "BROWSER=firefox bun --bun vite build",
    "build:watch": "bun --bun vite build --watch",
    "start": "bun --bun vite",
    "preview": "bun --bun vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "release:patch": "bun pm version patch",
    "release:minor": "bun pm version minor",
    "release:major": "bun pm version major",
    "postversion": "git push --follow-tags",
    "screenshots": "bun --bun playwright test -c playwright.screenshots.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@crxjs/vite-plugin": "^3.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "solid-js": "^1.9.17"
  }
}
